<Window x:Class="SScreentify.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SScreentify.App.Overlay"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="Black" UseLayoutRounding="True"
        Title="sScreentify" Cursor="Cross" Focusable="True">
    <Grid x:Name="Root" ClipToBounds="True">
        <Canvas x:Name="ImageHost">
            <Image x:Name="CaptureImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Canvas>
        <Canvas x:Name="AnnotationHost" />
        <local:SelectionAdorner x:Name="Adorner" />
        <Canvas x:Name="Chrome" x:FieldModifier="public" />
    </Grid>
</Window>
